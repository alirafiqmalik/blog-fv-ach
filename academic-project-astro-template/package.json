{
  "name": "blog-fv-ach",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "//": "test:unit runs .ts through Node's native type stripping (>=22.6) and relies on --test glob expansion (>=21).",
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "assert": "node scripts/assert-build.mjs",
    "test:unit": "node --test \"test/**/*.test.ts\"",
    "test:build": "astro build && npm run assert",
    "test": "npm run test:unit && npm run test:build",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier .",
    "format:fix": "prettier --write .",
    "all:fix": "astro check && eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@iconify-json/ri": "^1.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.5",
    "astro-expressive-code": "^0.41.3",
    "astro-icon": "^1.1.0",
    "katex": "^0.16.47",
    "motion": "^13.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rehype-citation": "^2.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.5.0",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.15",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^17.0.0",
    "linkedom": "^0.18.12",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwind-csstree": "^0.1.4",
    "typescript-eslint": "^8.51.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  }
}
