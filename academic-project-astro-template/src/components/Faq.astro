---
/**
 * Two-column FAQ accordion, native `<details>` so it works without JavaScript.
 * Content is `src/data/faq.ts`.
 */
import { FAQ } from "../data/faq.ts";

const midpoint = Math.ceil(FAQ.length / 2);
const columns = [FAQ.slice(0, midpoint), FAQ.slice(midpoint)] as const;
---

<p class="faq-hint not-prose">
  Click a question to reveal the answer; click again to hide it.
</p>

<div class="faq-grid not-prose" id="faq-list">
  {
    columns.map((column) => (
      <div class="faq-column">
        {column.map((entry) => (
          <details class="faq-entry">
            <summary>{entry.question}</summary>
            <div class="faq-body">
              {entry.answer.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </details>
        ))}
      </div>
    ))
  }
</div>
