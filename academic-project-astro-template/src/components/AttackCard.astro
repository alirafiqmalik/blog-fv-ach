---
/**
 * A brief card for one of the two attacks that are not the centrepiece
 * (docs/storyboard.md → Act III, "Two more of the same shape").
 *
 * The heading, the invariant and the root cause come from the data modules.
 * The plain-language story is the default slot — written once in the page,
 * against the storyboard — and the evidence goes in a `See the evidence`
 * disclosure so the screenshots do not stretch a brief mention into a
 * section.
 */
import { attackById } from "../data/attacks.ts";
import type { AttackId } from "../data/attacks.ts";
import { invariantById } from "../data/invariants.ts";
import Disclosure from "./Disclosure.astro";

interface Props {
  attack: AttackId;
}

const attack = attackById(Astro.props.attack);
const invariant = invariantById(attack.invariant);
const hasEvidence = Astro.slots.has("evidence");
---

<article class="not-prose my-8 rounded-2xl border border-border bg-card p-6 sm:p-8" id={attack.name.toLowerCase()}>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <span class="font-(family-name:--font-mono) text-sm font-semibold text-[var(--ach-accent)]">
      {attack.tag}
    </span>
    <h3 class="font-(family-name:--font-display) text-2xl font-semibold tracking-tight text-foreground">
      {attack.name}
    </h3>
    <span class="ml-auto font-(family-name:--font-mono) text-[0.65rem] tracking-[0.16em] text-[var(--text-muted)] uppercase">
      breaks {invariant.symbol} · {invariant.name}
    </span>
  </div>

  <div class="attack-story mt-4 space-y-3 text-[1.05rem] leading-relaxed text-[var(--text-secondary)]">
    <slot />
  </div>

  <dl class="mt-6 grid gap-4 border-t border-border pt-5 sm:grid-cols-2">
    <div>
      <dt class="font-(family-name:--font-mono) text-[0.6rem] tracking-[0.18em] text-[var(--text-muted)] uppercase">
        Root cause
      </dt>
      <dd class="mt-2 text-[0.85rem] leading-relaxed text-[var(--text-secondary)]">
        {attack.rootCause}
      </dd>
    </div>
    <div>
      <dt class="font-(family-name:--font-mono) text-[0.6rem] tracking-[0.18em] text-[var(--text-muted)] uppercase">
        Structural gap
      </dt>
      <dd class="mt-2 text-[0.85rem] leading-relaxed text-[var(--text-secondary)]">
        {attack.structuralGap}
      </dd>
    </div>
  </dl>

  {
    hasEvidence && (
      <Disclosure kicker="Evidence" summary={`See the evidence: ${attack.figures.join(", ")}`}>
        <slot name="evidence" />
      </Disclosure>
    )
  }
</article>

<style>
  .attack-story :global(p) {
    margin: 0;
  }
  .attack-story :global(strong) {
    color: var(--foreground);
  }
</style>
