---
/**
 * Lab-style footer matching the EMV project page: affiliation, contact, credit.
 */
import { SITE } from "../data/site.ts";
---

<footer class="lab-footer not-prose" id="contact">
  <div class="lab-footer-grid">
    <div>
      <p>
        We are part of the
        <a href={SITE.collegeUrl}>{SITE.college}</a>
        at
        <a href={SITE.universityUrl}>{SITE.university}</a>,
        in
        <a href={SITE.labUrl}>{SITE.lab}</a>.
      </p>
      <p>
        &copy; {new Date().getFullYear()}
        {SITE.author}. Layout inspired by the
        <a href="https://khwarizmilab.github.io/emvexpiredcards/">Khwarizmi Lab project pages</a>.
      </p>
    </div>
    <div>
      <p>Contact</p>
      <p>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        {SITE.location}
      </p>
      <p class="lab-footer-social">
        <a href={SITE.socials.github}>GitHub</a>
        ·
        <a href={SITE.socials.linkedin}>LinkedIn</a>
        ·
        <a href={SITE.socials.scholar}>Scholar</a>
      </p>
    </div>
  </div>
</footer>
