---
/**
 * The "Get in Touch" contact bar from alihamzamalik.me (`_includes/footer.html`
 * + the `.footer*` rules in `assets/css/main.css`), ported to Astro.
 *
 * `id="contact"` is what the nav's "Contacts" link targets — on the personal
 * site that link scrolls to this same block.
 */
import { SITE } from "../data/site.ts";
---

<footer class="footer not-prose" id="contact">
  <div class="footer-content">
    <div class="footer-top-divider" aria-hidden="true"></div>

    <div class="footer-contact-inner">
      <h2 class="footer-heading">
        Get in <span class="highlight">Touch</span>
      </h2>
      <p class="footer-description">{SITE.contactBlurb}</p>

      <div class="footer-social">
        <a
          href={SITE.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          href={SITE.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path>
          </svg>
        </a>
        <a
          href={SITE.socials.scholar}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Scholar"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"
            ></path>
          </svg>
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
      </div>

      <div class="footer-location">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{SITE.location}</span>
      </div>
    </div>

    <div class="footer-copyright">
      &copy; {new Date().getFullYear()}
      {SITE.author}. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 5.5rem;
    font-family: var(--font-body);
  }

  /* Aligned with the article column rather than the personal site's 1280px
     container, so the divider and the heading share the paper's measure. */
  .footer-content {
    width: 100%;
    max-width: calc(
      var(--maximum-text-width) + 2 * var(--minimum-inline-margin)
    );
    margin: 0 auto;
    padding: 0 var(--minimum-inline-margin);
  }

  .footer-top-divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--primary) 18%,
      var(--border) 52%,
      transparent 100%
    );
  }

  .footer-contact-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vh, 2rem);
    padding: 3rem 0 2rem;
  }

  .footer-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .highlight {
    color: var(--primary);
  }

  .footer-description {
    max-width: 40rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    line-height: 1.75;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 50%;
    text-decoration: none;
    transition:
      color 0.3s,
      border-color 0.3s,
      transform 0.3s;
  }

  .footer-social a:hover,
  .footer-social a:focus-visible {
    color: var(--primary);
    border-color: var(--primary);
    transform: scale(1.06);
  }

  .footer-social svg {
    width: 1.875rem;
    height: 1.875rem;
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
    font-size: 0.9375rem;
  }

  .footer-location svg {
    flex-shrink: 0;
  }

  .footer-copyright {
    width: 100%;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .footer-social {
      gap: 1rem;
    }

    .footer-social a {
      width: 3rem;
      height: 3rem;
    }

    .footer-social svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social a {
      transition: none;
    }

    .footer-social a:hover,
    .footer-social a:focus-visible {
      transform: none;
    }
  }
</style>
