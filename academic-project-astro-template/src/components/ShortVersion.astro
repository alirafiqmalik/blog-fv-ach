---
/**
 * The whole finding in four sentences (docs/storyboard.md → Reference layer),
 * for the reader who will not scroll. Content is `SHORT_VERSION` in
 * `src/data/faq.ts`, which the content test pins to four sentences that name
 * the disclosure dates.
 */
import { SHORT_VERSION } from "../data/faq.ts";
---

<aside class="not-prose my-10 rounded-2xl border border-[var(--ach-accent)]/40 bg-card p-6 sm:p-8">
  <span class="font-(family-name:--font-mono) text-[0.65rem] tracking-[0.18em] text-[var(--ach-accent)] uppercase">
    The short version
  </span>
  <ol class="mt-4 space-y-3">
    {
      SHORT_VERSION.map((sentence, i) => (
        <li class="flex gap-4">
          <span class="shrink-0 font-(family-name:--font-mono) text-xs text-[var(--text-muted)]">
            {i + 1}
          </span>
          <span class="text-[1.05rem] leading-relaxed text-foreground">{sentence}</span>
        </li>
      ))
    }
  </ol>
</aside>
