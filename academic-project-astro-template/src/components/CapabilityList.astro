---
/**
 * The adversary's four capabilities (docs/storyboard.md → Act II, "The
 * model"), from `CAPABILITIES` in `src/data/method.ts`. The point of the list
 * is the last line of the storyboard block: nothing here is exotic, every
 * capability is a feature — so the cards are quiet, and the short names lead.
 */
import { CAPABILITIES } from "../data/method.ts";
---

<ol class="not-prose my-8 grid gap-3 sm:grid-cols-2">
  {
    CAPABILITIES.map((capability) => (
      <li class="rounded-2xl border border-border bg-card p-5">
        <div class="flex items-baseline gap-3">
          <span class="font-(family-name:--font-mono) text-xs font-semibold text-[var(--ach-debit)]">
            {capability.id}
          </span>
          <span class="font-(family-name:--font-display) text-base font-semibold tracking-tight text-foreground">
            {capability.short}
          </span>
        </div>
        <p class="mt-2 text-[0.9rem] leading-relaxed text-[var(--text-secondary)]">
          {capability.text}
        </p>
      </li>
    ))
  }
</ol>
