---
// Two equal columns that collapse cleanly; each pane is a card so root-cause
// vs structural-gap reads as a pair, not as two prose blobs.
---

<div class="my-8 grid w-full gap-4 md:grid-cols-2">
  <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 [&>:first-child]:mt-0 [&>:last-child]:mb-0">
    <slot name="left" />
  </div>
  <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 [&>:first-child]:mt-0 [&>:last-child]:mb-0">
    <slot name="right" />
  </div>
</div>
