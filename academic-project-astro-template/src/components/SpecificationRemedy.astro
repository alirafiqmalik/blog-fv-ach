---
/**
 * The one remedy that targets the rulebook rather than a property
 * (docs/storyboard.md → Act IV, "The fix"). The three invariant cards carry
 * the other four; this one sits beneath them, naming the underspecifications
 * it closes.
 */
import { REMEDIES } from "../data/disclosure.ts";

const remedy = REMEDIES.find((r) => r.invariant === null);
if (!remedy) throw new Error("no specification-level remedy in REMEDIES");
---

<div class="not-prose my-6 rounded-2xl border border-border bg-card p-5 sm:p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-(family-name:--font-display) text-base font-semibold tracking-tight text-foreground sm:text-lg">
      {remedy.title}
    </h3>
    <span class="font-(family-name:--font-mono) text-[0.65rem] tracking-[0.16em] text-[var(--text-muted)] uppercase">
      closes {remedy.closes?.join(" · ")}
    </span>
  </div>
  <p class="mt-3 text-[0.95rem] leading-relaxed text-[var(--text-secondary)]">
    {remedy.text}
  </p>
</div>
