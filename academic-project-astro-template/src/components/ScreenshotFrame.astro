---
/**
 * A frame for the paper's redacted dashboard screenshots.
 *
 * The screenshots are white banking UI. They sit on a light card so the
 * pixels still match the paper — inverting them would falsify the evidence.
 */
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  figure: string;
  caption: string;
  callout?: string;
}

const { src, alt, figure, caption, callout } = Astro.props;
---

<figure class="screenshot-exhibit not-prose my-8">
  <div class="screenshot-mat">
    <div class="screenshot-kicker">
      <span>Exhibit</span>
      <span>{figure}</span>
    </div>
    <div class="screenshot-plate">
      <Picture
        class="screenshot-image"
        src={src}
        alt={alt}
        layout="constrained"
        formats={["avif"]}
        loading="lazy"
        fit="contain"
      />
    </div>
  </div>
  <figcaption class="screenshot-caption">
    <span class="screenshot-figure">{figure}</span>
    <span class="screenshot-text">{caption}</span>
    {
      callout && (
        <span class="screenshot-callout">
          {callout}
        </span>
      )
    }
  </figcaption>
</figure>
