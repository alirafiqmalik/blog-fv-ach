---
/**
 * The floating pill navigation from alihamzamalik.me, ported to Astro.
 *
 * The demo deploys to its own project site (/blog-fv-ach), so every
 * section link points at the live personal site rather than at a local route;
 * only "Contacts" stays on this page, where the contact bar lives.
 *
 * The reference implementation is Jekyll — `_includes/navigation.html` plus the
 * `.nav*` rules in `assets/css/main.css` and the nav block of `assets/js/main.js`.
 * Behaviour kept: scrolled state, reading-progress bar, More dropdown with a
 * Tools submenu (click, outside-click and Escape), and the mobile menu.
 */
import { SITE } from "../data/site.ts";

/** Shown after the `~/` in the prompt logo — this page's "working directory". */
const cwd = "blog/fv-ach";

/**
 * On-page sections, in scroll order (docs/storyboard.md → §0). These are the
 * primary links: a reader arrives here for the paper, not for the rest of the
 * personal site, which moves under "More".
 */
const links = [
  { name: "Overview", url: "#overview" },
  { name: "ACH", url: "#how-ach-works" },
  { name: "Method", url: "#method" },
  { name: "Attacks", url: "#attacks" },
  { name: "Evidence", url: "#evidence" },
  { name: "Impact", url: "#impact" },
  { name: "FAQ", url: "#faq" },
];

const more = [
  { name: "About", url: `${SITE.home}/#about` },
  { name: "Publications", url: `${SITE.home}/#publications` },
  { name: "Blog", url: `${SITE.home}/blog/` },
  { name: "CV", url: `${SITE.home}/cv/` },
  { name: "Projects", url: `${SITE.home}/projects/` },
];

const tools = [{ name: "Deadlines", url: `${SITE.home}/sec-deadlines/` }];

/**
 * The reading-progress track is labelled as the settlement timeline the whole
 * story runs on, so the chrome itself teaches the unit of time. Ticks are
 * evenly spaced banking days, not a measurement of the page.
 */
const settlementDays = ["Day 0", "Day 1", "Day 2", "Day 3", "Day 4", "Day 5"];
---

<nav class="nav not-prose" id="site-nav">
  <div class="nav-content">
    <a class="nav-logo-prompt" href={`${SITE.home}/`} aria-label="Home">
      <span class="nav-prompt-user">alihamza@malik</span>
      <span class="nav-prompt-glyph" aria-hidden="true">❯</span>
      <span class="nav-prompt-path"
        >~/<span class="nav-prompt-cwd">{cwd}</span></span
      >
    </a>

    <div class="nav-links">
      {
        links.map((link) => (
          <a href={link.url} class="nav-link">
            {link.name}
          </a>
        ))
      }

      <div class="nav-actions">
        <div class="nav-dropdown">
          <button
            type="button"
            class="nav-cta nav-cta-outline nav-dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
          >
            More
            <svg
              class="nav-dropdown-chevron"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="nav-dropdown-menu" role="menu">
            {
              more.map((item) => (
                <a href={item.url} class="nav-dropdown-item" role="menuitem">
                  {item.name}
                </a>
              ))
            }
            <div class="nav-dropdown-submenu">
              <button
                type="button"
                class="nav-dropdown-item nav-dropdown-submenu-toggle"
                aria-expanded="false"
                aria-haspopup="true"
              >
                Tools
                <svg
                  class="nav-dropdown-submenu-chevron"
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
              <div class="nav-dropdown-submenu-menu" role="menu">
                {
                  tools.map((item) => (
                    <a
                      href={item.url}
                      class="nav-dropdown-item"
                      role="menuitem"
                    >
                      {item.name}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="mobile-menu-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="site-mobile-menu"
    >
      <svg
        class="icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
      <svg
        class="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" x2="6" y1="6" y2="18"></line>
        <line x1="6" x2="18" y1="6" y2="18"></line>
      </svg>
    </button>

    <div class="nav-progress-container" aria-hidden="true">
      <div class="nav-progress-ticks">
        {
          settlementDays.map((day) => (
            <span class="nav-progress-tick" data-day={day} />
          ))
        }
      </div>
      <div class="nav-progress-bar"></div>
    </div>
  </div>

  <div class="mobile-menu" id="site-mobile-menu">
    {
      links.map((link) => (
        <a href={link.url} class="nav-link">
          {link.name}
        </a>
      ))
    }
    <div class="mobile-more-group">
      <span class="mobile-more-label">More</span>
      {
        more.map((item) => (
          <a href={item.url} class="nav-link">
            {item.name}
          </a>
        ))
      }
      <span class="mobile-more-label mobile-tools-label">Tools</span>
      {
        tools.map((item) => (
          <a href={item.url} class="nav-link mobile-tools-link">
            {item.name}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("site-nav");
  if (nav) {
    // -- scrolled state + reading progress ---------------------------------
    // The bar is scaled, not resized: only transform/opacity animate here.
    const bar = nav.querySelector<HTMLElement>(".nav-progress-bar");
    const onScroll = () => {
      nav.classList.toggle("scrolled", window.scrollY > 20);
      if (!bar) return;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      const pct = scrollable > 0 ? window.scrollY / scrollable : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, pct))})`;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();

    // -- active section (desktop links only) -------------------------------
    const sectionLinks = [
      ...nav.querySelectorAll<HTMLAnchorElement>(".nav-links > a.nav-link"),
    ];
    const observed = sectionLinks
      .map((link) => {
        const href = link.getAttribute("href") ?? "";
        return href.startsWith("#") ? document.getElementById(href.slice(1)) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (observed.length > 0 && "IntersectionObserver" in window) {
      const spy = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible?.target.id) return;
          for (const link of sectionLinks) {
            link.classList.toggle(
              "active",
              link.getAttribute("href") === `#${visible.target.id}`,
            );
          }
        },
        { rootMargin: "-18% 0px -62% 0px", threshold: [0, 0.2, 0.5, 1] },
      );
      for (const section of observed) spy.observe(section);
    }

    // -- More dropdown and its Tools submenu -------------------------------
    const closeAll = (selector: string, toggleSelector: string) => {
      for (const open of document.querySelectorAll(selector)) {
        open.classList.remove("open");
        open
          .querySelector(toggleSelector)
          ?.setAttribute("aria-expanded", "false");
      }
    };
    const closeMenus = () => {
      closeAll(".nav-dropdown.open", ".nav-dropdown-toggle");
      closeAll(".nav-dropdown-submenu.open", ".nav-dropdown-submenu-toggle");
    };

    for (const [container, toggleClass] of [
      [".nav-dropdown", ".nav-dropdown-toggle"],
      [".nav-dropdown-submenu", ".nav-dropdown-submenu-toggle"],
    ] as const) {
      for (const dropdown of nav.querySelectorAll(container)) {
        const toggle = dropdown.querySelector(`:scope > ${toggleClass}`);
        toggle?.addEventListener("click", (event) => {
          event.stopPropagation();
          const isOpen = dropdown.classList.toggle("open");
          toggle.setAttribute("aria-expanded", String(isOpen));
        });
        for (const link of dropdown.querySelectorAll(":scope > div a")) {
          link.addEventListener("click", closeMenus);
        }
      }
    }

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target?.closest(".nav-dropdown")) closeMenus();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenus();
    });

    // -- mobile menu -------------------------------------------------------
    const menuButton = nav.querySelector<HTMLButtonElement>(".mobile-menu-btn");
    const mobileMenu = nav.querySelector<HTMLElement>(".mobile-menu");
    if (menuButton && mobileMenu) {
      const setMenu = (open: boolean) => {
        mobileMenu.classList.toggle("open", open);
        nav.classList.toggle("menu-open", open);
        menuButton.setAttribute("aria-expanded", String(open));
      };
      menuButton.addEventListener("click", () => {
        setMenu(!mobileMenu.classList.contains("open"));
      });
      for (const link of mobileMenu.querySelectorAll("a")) {
        link.addEventListener("click", () => setMenu(false));
      }
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
      });
    }
  }
</script>

<style>
  /* Ported from assets/css/main.css on alihamzamalik.me, remapped onto this
     project's palette tokens so the two sites cannot drift apart. */
  .nav {
    position: fixed;
    top: var(--nav-float-top);
    left: var(--nav-float-gutter);
    right: var(--nav-float-gutter);
    z-index: 50;
    width: calc(100% - 2 * var(--nav-float-gutter));
    pointer-events: none;
    font-family: var(--font-body);
  }

  .nav-content,
  .mobile-menu {
    pointer-events: auto;
  }

  .nav-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-float-height);
    padding: 0 1.25rem;
    background: color-mix(in srgb, var(--card) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-muted);
    border-radius: var(--nav-float-radius);
    box-shadow:
      0 8px 32px rgb(0 0 0 / 0.38),
      0 2px 8px rgb(0 0 0 / 0.22);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .nav.scrolled .nav-content {
    background: color-mix(in srgb, var(--popover) 97%, transparent);
    box-shadow:
      0 12px 40px rgb(0 0 0 / 0.45),
      0 2px 10px rgb(0 0 0 / 0.28);
  }

  /* Reading progress, inset so the track sits inside the pill's rounding.
     Styled as the settlement timeline (docs/storyboard.md → §0): the track is
     Day 0 → Day 5, ticked at the banking days, and the fill is the payment
     travelling along it. */
  .nav-progress-container {
    position: absolute;
    left: calc(var(--nav-float-radius) * 0.72);
    right: calc(var(--nav-float-radius) * 0.72);
    bottom: 0;
    height: 3px;
    background: rgb(51 51 51 / 0.5);
    border-radius: 999px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .nav.scrolled .nav-progress-container {
    opacity: 1;
  }

  .nav-progress-ticks {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
  }

  .nav-progress-tick {
    width: 1px;
    height: 100%;
    background: rgb(141 141 141 / 0.55);
  }

  .nav-progress-bar {
    position: relative;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    /* The fill runs from provisional to settled, which is the arc of the page. */
    background: linear-gradient(
      90deg,
      var(--ach-provisional) 0%,
      var(--ach-accent) 100%
    );
    border-radius: 999px;
    transition: transform 0.12s ease-out;
  }

  /* Prompt logo */
  .nav-logo-prompt {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
    max-width: min(18rem, 42vw);
    font-family:
      ui-monospace, "SFMono-Regular", "SF Mono", "Cascadia Code",
      "Segoe UI Mono", Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--foreground);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-prompt-user {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--foreground);
  }

  .nav-prompt-glyph {
    flex-shrink: 0;
    color: var(--primary);
    font-weight: 600;
  }

  .nav-prompt-path {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-secondary);
  }

  .nav-prompt-cwd {
    color: var(--foreground);
  }

  /* Links */
  .nav-links {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.3s;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.4rem;
    height: 1px;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.22s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.active {
    color: var(--foreground);
  }

  .nav-link.active::after,
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .mobile-menu .nav-link::after {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .nav-cta-outline {
    background-color: transparent;
    color: var(--foreground);
    border-color: rgb(245 245 245 / 0.35);
  }

  .nav-cta-outline:hover,
  .nav-cta-outline:focus-visible {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-toggle {
    cursor: pointer;
  }

  .nav-dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .nav-dropdown.open .nav-dropdown-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    min-width: 10rem;
    padding: 0.5rem;
    background: color-mix(in srgb, var(--card) 98%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    z-index: 60;
  }

  .nav-dropdown.open .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-item {
    display: block;
    width: 100%;
    padding: 0.625rem 0.875rem;
    border-radius: calc(var(--radius) - 2px);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav-dropdown-item:hover,
  .nav-dropdown-item:focus-visible {
    color: var(--foreground);
    background-color: var(--accent);
  }

  .nav-dropdown-submenu {
    position: relative;
  }

  .nav-dropdown-submenu-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    cursor: pointer;
  }

  .nav-dropdown-submenu-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .nav-dropdown-submenu.open .nav-dropdown-submenu-chevron {
    transform: rotate(90deg);
  }

  .nav-dropdown-submenu-menu {
    position: absolute;
    top: 0;
    right: calc(100% + 0.5rem);
    min-width: 9rem;
    padding: 0.5rem;
    background: color-mix(in srgb, var(--card) 98%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateX(0.5rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    z-index: 61;
  }

  .nav-dropdown-submenu.open .nav-dropdown-submenu-menu,
  .nav-dropdown-submenu:hover .nav-dropdown-submenu-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  /* Mobile */
  .mobile-menu-btn {
    display: block;
    padding: 0.5rem;
    border-radius: 999px;
    color: var(--foreground);
    transition: background-color 0.3s;
  }

  .mobile-menu-btn:hover {
    background-color: rgb(255 255 255 / 0.06);
  }

  .mobile-menu-btn .icon-close,
  .nav.menu-open .mobile-menu-btn .icon-open {
    display: none;
  }

  .nav.menu-open .mobile-menu-btn .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    max-height: calc(100dvh - var(--nav-offset) - 1rem);
    overflow-y: auto;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--popover) 98%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgb(255 255 255 / 0.06);
    border-radius: 1.25rem;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.4);
    z-index: 49;
  }

  .mobile-menu.open {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-menu .nav-link {
    display: block;
    padding: 0.75rem 0;
    font-size: 1rem;
    text-align: left;
  }

  .mobile-more-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .mobile-more-label {
    padding: 0.25rem 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .mobile-tools-label {
    margin-top: 0.5rem;
  }

  .mobile-tools-link {
    padding-left: 0.75rem;
  }

  /* Below the desktop breakpoint only the hamburger shares the pill, so the
     prompt can keep its full path instead of ellipsing. */
  @media (max-width: 767px) {
    .nav-logo-prompt {
      max-width: min(18rem, 64vw);
    }
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }

    .mobile-menu-btn,
    .mobile-menu {
      display: none;
    }
  }

  /* Compact tablet / small laptop nav — avoid crowding the links + More. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .nav-content {
      padding: 0 1rem;
    }

    .nav-links {
      gap: 1.1rem;
    }

    .nav-link {
      font-size: 0.8125rem;
    }

    .nav-cta {
      padding: 0.5rem 0.95rem;
      font-size: 0.8125rem;
    }

    .nav-logo-prompt {
      max-width: min(11.5rem, 26vw);
      font-size: 0.75rem;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav-links {
      gap: 1.35rem;
    }

    .nav-logo-prompt {
      max-width: min(15rem, 24vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-content,
    .nav-progress-container,
    .nav-progress-bar,
    .nav-dropdown-menu,
    .nav-dropdown-submenu-menu,
    .nav-dropdown-chevron,
    .nav-dropdown-submenu-chevron,
    .nav-link::after {
      transition: none;
    }
  }
</style>
