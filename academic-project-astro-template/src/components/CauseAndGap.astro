---
/**
 * Root cause, structural gap and the invariant broken, for one attack
 * (docs/storyboard.md → Act III, "Copy, after the scene").
 *
 * Three cards from `src/data/attacks.ts` and `src/data/invariants.ts`. The
 * invariant card leads with the plain-language line; the formula is one line
 * underneath in the mono face, small, for the reader who wants it.
 */
import { attackById } from "../data/attacks.ts";
import type { AttackId } from "../data/attacks.ts";
import { invariantById } from "../data/invariants.ts";

interface Props {
  attack: AttackId;
}

const attack = attackById(Astro.props.attack);
const invariant = invariantById(attack.invariant);
---

<div class="not-prose my-10 grid gap-4 md:grid-cols-3">
  <div class="rounded-2xl border border-border bg-card p-5 sm:p-6">
    <span class="font-(family-name:--font-mono) text-[0.6rem] tracking-[0.18em] text-[var(--text-muted)] uppercase">
      Root cause
    </span>
    <p class="mt-3 text-[0.9rem] leading-relaxed text-[var(--text-secondary)]">
      {attack.rootCause}
    </p>
  </div>
  <div class="rounded-2xl border border-border bg-card p-5 sm:p-6">
    <span class="font-(family-name:--font-mono) text-[0.6rem] tracking-[0.18em] text-[var(--text-muted)] uppercase">
      Structural gap
    </span>
    <p class="mt-3 text-[0.9rem] leading-relaxed text-[var(--text-secondary)]">
      {attack.structuralGap}
    </p>
  </div>
  <div class="rounded-2xl border p-5 sm:p-6" style="border-color: var(--ach-debit)">
    <span class="font-(family-name:--font-mono) text-[0.6rem] tracking-[0.18em] uppercase" style="color: var(--ach-debit)">
      Property broken · {invariant.symbol}
    </span>
    <p class="mt-3 font-(family-name:--font-display) text-base font-semibold leading-snug text-foreground">
      {invariant.name}
    </p>
    <p class="mt-2 text-[0.9rem] leading-relaxed text-[var(--text-secondary)]">
      {invariant.plain}
    </p>
    <code class="mt-4 block overflow-x-auto font-(family-name:--font-mono) text-[0.7rem] leading-relaxed text-[var(--text-muted)]">
      {invariant.formal}
    </code>
  </div>
</div>
