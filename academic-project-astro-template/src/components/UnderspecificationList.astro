---
/**
 * U1, U2 and U3 in full (docs/storyboard.md → Act II, "The rules do not
 * say"), for the engineers' box: the problem, the rule text where the paper
 * quotes it, and how the model resolved it. Content is `UNDERSPECIFICATIONS`
 * in `src/data/method.ts`; the five timing ambiguities of the paper's Table 2
 * follow U2.
 */
import { TIMING_AMBIGUITIES, UNDERSPECIFICATIONS } from "../data/method.ts";
---

<div class="not-prose space-y-6">
  {
    UNDERSPECIFICATIONS.map((u) => (
      <section>
        <h4 class="font-(family-name:--font-display) text-base font-semibold tracking-tight text-foreground">
          <span class="mr-2 font-(family-name:--font-mono) text-xs text-[var(--ach-accent)]">{u.id}</span>
          {u.title}
        </h4>
        <p class="mt-2 text-[0.9rem] leading-relaxed text-[var(--text-secondary)]">{u.problem}</p>
        {u.quote && (
          <blockquote class="mt-3 border-l-2 border-[var(--ach-accent)] pl-4 text-[0.9rem] leading-relaxed text-[var(--text-secondary)] italic">
            “{u.quote}”
            <span class="mt-1 block font-(family-name:--font-mono) text-[0.65rem] tracking-wider text-[var(--text-muted)] uppercase not-italic">
              Nacha Operating Rules, {u.quoteSource}
            </span>
          </blockquote>
        )}
        {u.id === "U2" && (
          <table class="mt-4 w-full border-collapse text-[0.8rem]">
            <tbody>
              {TIMING_AMBIGUITIES.map((row) => (
                <tr class="border-t border-border">
                  <th class="py-2 pr-4 text-left align-top font-(family-name:--font-mono) text-[0.7rem] font-medium whitespace-nowrap text-foreground">
                    {row.process}
                  </th>
                  <td class="py-2 align-top leading-relaxed text-[var(--text-secondary)]">{row.ambiguity}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <p class="mt-3 text-[0.9rem] leading-relaxed text-[var(--text-secondary)]">
          <span class="font-(family-name:--font-mono) text-[0.65rem] tracking-wider text-[var(--ach-credit)] uppercase">
            Resolved ·
          </span>{" "}
          {u.resolution}
        </p>
      </section>
    ))
  }
</div>
