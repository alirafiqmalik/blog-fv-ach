---
/**
 * The paper's Table 1 (docs/storyboard.md → Act III, "Two more of the same
 * shape"): design rationale, implicit assumption, exploit and impact, per
 * attack. Rendered from `ATTACKS[*].summary`, whose wording
 * `test/content.test.ts` checks against paper.md, so the table cannot say
 * anything the paper does not.
 */
import { ATTACKS } from "../data/attacks.ts";
import { invariantById } from "../data/invariants.ts";

const rows: { label: string; key: keyof (typeof ATTACKS)[number]["summary"] }[] = [
  { label: "Design rationale", key: "rationale" },
  { label: "Implicit assumption", key: "assumption" },
  { label: "Exploit", key: "exploit" },
  { label: "Impact", key: "impact" },
];
---

<figure class="not-prose my-10">
  <figcaption class="mb-3 text-center font-(family-name:--font-mono) text-[0.65rem] tracking-[0.18em] text-[var(--text-muted)] uppercase">
    Table 1 · the three instances, side by side
  </figcaption>
  <div class="full-bleed overflow-x-auto px-6">
    <!-- A floor on the width so a phone scrolls the table sideways inside
         its wrapper instead of wrapping every cell one word per line. -->
    <table class="booktabs mx-auto w-auto min-w-[44rem]">
      <thead>
        <tr>
          <th></th>
          {
            ATTACKS.map((attack) => (
              <th>
                <span class="block text-[var(--ach-accent)]">{attack.tag}</span>
                <span class="block">{attack.name}</span>
                <span class="block font-normal text-[var(--text-muted)]">
                  breaks {invariantById(attack.invariant).symbol}
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td class="text-[var(--text-muted)]">{row.label}</td>
              {ATTACKS.map((attack) => (
                <td>{attack.summary[row.key]}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>
