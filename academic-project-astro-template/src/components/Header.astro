---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url?: string;
  name: string;
  icon?: string;
  /** id of an element this button shows/hides instead of navigating. */
  toggles?: string;
};

interface Props {
  title: string;
  /** Second title line, rendered smaller so it holds one line. */
  subtitle?: string;
  /** One-line hook under the masthead — unused on the lab-style layout. */
  dek?: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, subtitle, dek, authors, conference, notes, links } = Astro.props;
---

<header class="lab-hero">
  <h1>{title}</h1>
  {subtitle && <h2>{subtitle}</h2>}
  {
    dek && (
      <p class="lab-hero-dek">{dek}</p>
    )
  }
  <p class="lab-hero-authors">
    {
      authors.map((author, index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          {author.url ? (
            <a href={author.url}>{author.name}</a>
          ) : (
            <span>{author.name}</span>
          )}
        </>
      ))
    }
  </p>
  {conference && <p class="lab-hero-venue">{conference}</p>}
  {
    notes && (
      <p class="lab-hero-notes">
        {notes.map((note) => (
          <span>
            <sup>{note.symbol}</sup>
            {note.text}
          </span>
        ))}
      </p>
    )
  }
  {
    links && (
      <p class="lab-hero-actions">
        {links.map((link) =>
          link.toggles ? (
            <button
              type="button"
              class="lab-btn"
              data-header-toggles={link.toggles}
              aria-expanded="false"
              aria-controls={link.toggles}
            >
              {link.icon && <Icon name={link.icon} />}
              {link.name}
            </button>
          ) : (
            <a href={link.url} class="lab-btn">
              {link.icon && <Icon name={link.icon} />}
              {link.name}
            </a>
          ),
        )}
      </p>
    )
  }
</header>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-header-toggles]",
  )) {
    const target = document.getElementById(
      button.dataset.headerToggles ?? "",
    );
    if (!target) continue;
    button.addEventListener("click", () => {
      const nowHidden = target.toggleAttribute("hidden");
      button.setAttribute("aria-expanded", String(!nowHidden));
      if (!nowHidden) {
        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        target.scrollIntoView({
          behavior: reduced ? "auto" : "smooth",
          block: "start",
        });
      }
    });
  }
</script>
