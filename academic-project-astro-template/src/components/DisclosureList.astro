---
/**
 * The disclosure timeline as a static list (docs/storyboard.md → Act IV).
 *
 * The same `MILESTONES` the sideways-scrubbing `DisclosureTimeline` scene
 * reads, rendered in document flow with the three status markers per
 * milestone. Version 1 uses this; version 4 mounts the scene and this stays
 * as its narrow-viewport fallback.
 */
import { ATTACKS } from "../data/attacks.ts";
import { DISCLOSURE_NOTE, MILESTONES } from "../data/disclosure.ts";
---

<ol class="not-prose my-10 border-l border-border pl-6 sm:pl-8">
  {
    MILESTONES.map((milestone) => (
      <li class="relative pb-8 last:pb-0">
        <span
          class="absolute top-1.5 -left-[calc(1.5rem+4px)] h-2 w-2 rounded-full bg-[var(--ach-accent)] sm:-left-[calc(2rem+4px)]"
          aria-hidden="true"
        />
        <span class="font-(family-name:--font-mono) text-[0.65rem] tracking-[0.18em] text-[var(--ach-provisional)] uppercase">
          {milestone.label}
        </span>
        <h3 class="mt-1 font-(family-name:--font-display) text-lg font-semibold tracking-tight text-foreground sm:text-xl">
          {milestone.headline}
        </h3>
        <p class="mt-2 max-w-[40rem] text-[0.9rem] leading-relaxed text-[var(--text-secondary)]">
          {milestone.detail}
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
          {ATTACKS.map((attack) => {
            const fixed = milestone.status[attack.id] === "fixed";
            return (
              <li class="flex items-center gap-2 font-(family-name:--font-mono) text-[0.65rem] tracking-wider uppercase">
                <span
                  class="h-2 w-2 rounded-full"
                  style={`background: ${fixed ? "var(--ach-credit)" : "var(--ach-debit)"}`}
                  aria-hidden="true"
                />
                <span class="text-[var(--text-muted)]">{attack.name}</span>
                <span style={`color: ${fixed ? "var(--ach-credit)" : "var(--ach-debit)"}`}>
                  {fixed ? "fixed" : "viable"}
                </span>
              </li>
            );
          })}
        </ul>
      </li>
    ))
  }
</ol>

<p class="not-prose my-8 max-w-[40rem] text-[0.95rem] leading-relaxed text-[var(--text-muted)]">
  {DISCLOSURE_NOTE}
</p>
