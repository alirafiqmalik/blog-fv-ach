---
/**
 * The page shell: <head>, fonts, link-preview card, the floating nav and the
 * contact footer. Every page on the site — the version chooser, the original
 * page and each `src/pages/versionN/` snapshot — renders through this one
 * layout, so the chrome cannot drift between versions.
 *
 * Used two ways:
 *   - from an `.astro` page, with `frontmatter`, `nav` and `cwd` as props;
 *   - from an `.mdx` page via `layout:` frontmatter, in which case Astro hands
 *     the MDX frontmatter in as `frontmatter` and `nav` / `cwd` ride along
 *     inside it.
 */
import { Font } from "astro:assets";

import SiteNav from "../components/SiteNav.astro";
import type { NavLink } from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

import "../styles/global.css";
import "katex/dist/katex-swap.css";

export interface Frontmatter {
  title: string;
  description?: string;
  favicon: string;
  thumbnail?: string;
  theme?: "device" | "light" | "dark";
  /** Primary nav links for this page, in scroll order. */
  nav?: NavLink[];
  /** The "working directory" shown in the nav's prompt logo. */
  cwd?: string;
}

interface Props {
  frontmatter: Frontmatter;
  nav?: NavLink[];
  cwd?: string;
}

const { frontmatter, nav = frontmatter.nav, cwd = frontmatter.cwd } = Astro.props;
const { title, description, favicon, thumbnail, theme = "device" } = frontmatter;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
---

<!doctype html>
<html class="bg-background" lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href={prefix + favicon} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {
      thumbnail && (
        <meta
          property="og:image"
          content={
            Astro.site ? new URL(prefix + thumbnail, Astro.site).href : prefix + thumbnail
          }
        />
      )
    }

    <Font
      cssVariable="--font-space-grotesk"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <Font
      cssVariable="--font-inter"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <Font
      cssVariable="--font-jetbrains-mono"
      preload={[{ subset: "latin", style: "normal" }]}
    />

    <title>{title}</title>
  </head>
  <body
    class="prose prose-xl prose-zinc prose-invert prose-a:text-ach-accent/90 prose-a:hover:text-ach-accent prose-a:underline prose-a:decoration-dashed prose-a:underline-offset-4 prose-a:hover:decoration-solid prose-a:font-normal prose-code:bg-[#1f1f1f] prose-code:text-[#e5e5e5] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-medium prose-code:before:content-none prose-code:after:content-none prose-headings:tracking-tight prose-h2:mt-24 prose-h2:mb-6 prose-h2:text-4xl sm:prose-h2:text-5xl prose-h3:mt-16 prose-p:text-pretty max-w-none pt-28 pb-0 font-(family-name:--font-inter) sm:pt-32"
  >
    <SiteNav links={nav} cwd={cwd} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
