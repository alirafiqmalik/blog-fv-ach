---
/**
 * The site root sends a reader to the default version
 * (`DEFAULT_VERSION` in src/data/versions.ts). GitHub Pages cannot answer a
 * real 3xx, so this is the static equivalent: an instant meta refresh, a
 * canonical link for crawlers, and a plain link for anyone whose browser
 * ignores both.
 */
import { defaultVersion } from "../data/versions.ts";
import { PAPER } from "../data/paper.ts";

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
const target = `${prefix}${defaultVersion().id}/`;
const canonical = Astro.site ? new URL(target, Astro.site).href : target;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
    <title>{PAPER.fullTitle}</title>
    <style>
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        background: #141414;
        color: #b3b3b3;
        font-family: Inter, system-ui, sans-serif;
      }
      a {
        color: #ceff00;
      }
    </style>
  </head>
  <body>
    <p>
      Redirecting to <a href={target}>{PAPER.fullTitle}</a>.
    </p>
  </body>
</html>
