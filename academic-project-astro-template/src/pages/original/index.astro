---
/**
 * The page as it was before the redesign, kept at /original/ so each new
 * version can be compared against it from the chooser. Content is
 * `src/paper.mdx`, unchanged.
 */
import Table from "../../components/Table.astro";
import Site from "../../layouts/Site.astro";
import type { Frontmatter } from "../../layouts/Site.astro";
import { versionById } from "../../data/versions.ts";

import { Content, frontmatter } from "../../paper.mdx";

const version = versionById("original");
---

<Site frontmatter={frontmatter as Frontmatter} nav={[...version.nav]} cwd={version.cwd}>
  <Content components={{ table: Table }} />
</Site>
